# Server-only values. Do not expose this file's secret value in the browser.
# Use the Project URL only, not the REST API URL ending in /rest/v1.
SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred: a Supabase sb_secret_... key. The legacy SERVICE_ROLE variable is
# temporarily supported only while rotating an existing deployment.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Comma-separated origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000
