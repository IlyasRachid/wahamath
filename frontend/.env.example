# Find these in Supabase: Project Settings → API. Use the Project URL only
# (for example https://your-project-ref.supabase.co), not the REST API URL.
# Never put the service_role key in a NEXT_PUBLIC variable or commit it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Local FastAPI URL. In the single Vercel deployment, omit this variable so
# browser requests use the same deployment origin under /api.
NEXT_PUBLIC_API_URL=http://localhost:8000
